# 复制成 .env 后按需修改。

# ============================================================================
#  模型配置
# ============================================================================

# 【DeepSeek】—— base_url 结尾不带 /v1
HARNESS_MODEL=deepseek-flash
HARNESS_BASE_URL=https://api.deepseek.com
HARNESS_API_KEY=sk-...
# 可选：deepseek-v4-pro（更强更贵）
# 可选：关掉默认开启的 thinking 模式，多轮工具调用会快很多
# HARNESS_THINKING=disabled

# 【OpenAI 官方】—— 不设置 base_url 就走 Responses API
# HARNESS_MODEL=gpt-4.1-mini
# HARNESS_API_KEY=sk-...
# HARNESS_BASE_URL=

# 【Kimi / Moonshot】
# HARNESS_BASE_URL=https://api.moonshot.cn/v1
# HARNESS_MODEL=moonshot-v1-8k
# HARNESS_API_KEY=sk-...

# 【本地 Ollama】—— 不需要 key
# HARNESS_BASE_URL=http://localhost:11434/v1
# HARNESS_MODEL=qwen3:8b

# ============================================================================
#  以下一般不用改
# ============================================================================

# 工作区与产物目录（相对当前工作目录）
HARNESS_WORKSPACE=./workspace
HARNESS_RUNS_DIR=./runs

# 编排参数
HARNESS_MAX_TURNS=12
HARNESS_WORKER_MAX_TURNS=8
# 长会话最多把多少条历史交给模型。旧记录会折叠成本地摘要，原文仍留在
# runs/sessions.db；设为 0 可关闭折叠。
HARNESS_SESSION_ITEM_LIMIT=80
# 模型请求空闲超过这个秒数就中断，避免网络挂起时无限等待。
HARNESS_MODEL_TIMEOUT=120
# 失败请求最多重试几次。
HARNESS_MODEL_MAX_RETRIES=1
# 小任务直接走 coder 快速路径；off 总是走 supervisor，always 总是快速路径。
HARNESS_ROUTING=auto
HARNESS_FAST_PATH_MAX_TURNS=8
# 实验性：同一 agent 内重复读取折叠。默认关闭，因为 worker 上下文彼此隔离，
# 共享缓存会让另一个 worker 看不到文件正文。需要时用 --dedupe-reads 开启。
HARNESS_DEDUPE_TOOLS=0
# 单次文件读取最多返回多少字符，避免大文件一次吃满上下文。
HARNESS_TOOL_OUTPUT_CHARS=24000

# 允许 worker 执行 shell 命令。默认关闭，开启后视为信任模型。
HARNESS_ALLOW_SHELL=0
# 开了 shell 之后，每条命令执行前都要你批准（--approve / --reject）。
# 设成 0 就是完全放行，不再询问 —— 只有在你完全信任模型时才这么做。
HARNESS_APPROVE_SHELL=1
HARNESS_SHELL_TIMEOUT=60

# 工具 JSON Schema 严格模式。
# 只有 OpenAI 官方模型支持；DeepSeek 等兼容端点必须保持 0，否则会被拒。
HARNESS_STRICT_TOOLS=0

# 追踪：local（只留在本机）/ openai（同时上传 OpenAI 面板）/ off
HARNESS_TRACING=local
